APP_NAME=KavachAI
APP_ENV=development
DEBUG=true

# Postgres — used starting Step 2
DATABASE_URL=postgresql+psycopg://kavachai:kavachai@localhost:5432/kavachai

# Redis — used starting later steps
REDIS_URL=redis://localhost:6379/0

# JWT — used starting Step 2
JWT_SECRET_KEY=replace-this-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI explanation layer (optional) — get a key at https://aistudio.google.com/apikey
# Leave blank to use the deterministic template fallback instead of a live LLM call.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
